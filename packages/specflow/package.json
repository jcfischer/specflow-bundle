{
  "name": "specflow",
  "version": "0.1.0",
  "description": "Multi-agent orchestration for spec-driven development",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "specflow": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build --compile --outfile=specflow src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
